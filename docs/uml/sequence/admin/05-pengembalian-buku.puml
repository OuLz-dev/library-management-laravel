@startuml
title Pengembalian Buku
autonumber
actor Admin as A
participant "Halaman\nPengembalian" as H
participant "Sistem" as S
participant "Data Peminjaman" as P
participant "Data Buku" as B
participant "Data Denda" as D
database "Database" as DB

A -> H : Buka menu Pengembalian
H -> S : Minta data pengembalian
S -> P : Ambil riwayat pengembalian
P -> DB : Baca data pengembalian
DB --> P : Riwayat pengembalian
S --> H : Tampilkan riwayat dan kolom pencarian

A -> H : Cari kode peminjaman, nama, atau judul buku
H -> S : Kirim kata kunci
S -> P : Cari peminjaman aktif dan riwayat
P -> DB : Baca data yang cocok
DB --> P : Hasil pencarian
alt Kode persis ditemukan
  S --> H : Buka halaman proses pengembalian
else Tidak persis
  S --> H : Tampilkan peminjaman aktif yang cocok
end
H --> A : Pilih peminjaman

A -> H : Isi tanggal pengembalian
H -> S : Kirim tanggal pengembalian
S -> P : Ambil data peminjaman
P -> DB : Baca data peminjaman
DB --> P : Data peminjaman
S -> S : Periksa tanggal pengembalian
note right of S : Tidak melebihi hari ini\ndan tidak sebelum tanggal pinjam
alt Tanggal tidak valid
  S --> H : Tampilkan pesan kesalahan
else Tanggal valid
  S -> P : Tandai peminjaman selesai
  P -> DB : Ubah status peminjaman
  S -> B : Tambah stok buku
  B -> DB : Ubah jumlah stok
  S -> S : Hitung keterlambatan
  alt Terlambat
    S -> D : Catat denda
    D -> DB : Tulis data denda
    DB --> D : Denda tersimpan
    S --> H : Pesan terlambat + jumlah denda
  else Tepat waktu
    S --> H : Pesan pengembalian berhasil
  end
  H --> A : Tampilkan hasil
end
@enduml
